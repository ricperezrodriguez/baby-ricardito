{
  "name": "baby-ricardito-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start -w apps/web",
    "build": "npm run build -w apps/web",
    "watch": "npm run watch -w apps/web",
    "test": "npm run test -w apps/web",
    "api": "npm run dev -w apps/api",
    "typecheck": "npm run typecheck -w packages/contracts -w apps/api"
  }
}
